{
  "name": "cuthol",
  "version": "0.4.0",
  "description": "Agent-first open-source non-linear video editor (NLE) powered by HyperFrames and open media standards.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cuthol": "./dist/cli.js",
    "cuthol-mcp": "./dist/mcp_bin.js"
  },
  "keywords": [
    "video-editor",
    "nle",
    "mcp",
    "ai-agents",
    "ffmpeg",
    "hyperframes",
    "motion-graphics",
    "captions",
    "cli",
    "timeline",
    "color-grading"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuthol/cuthol.git"
  },
  "homepage": "https://cuthol.com",
  "bugs": {
    "url": "https://github.com/cuthol/cuthol/issues",
    "email": "hello@cuthol.com"
  },
  "files": [
    "dist",
    "!dist/test",
    "src/live/ui",
    "skills",
    "scripts/local_speech.py",
    "examples",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:serial": "node --import ./dist/test/test_setup.js --test --test-concurrency=1 dist/test/*.test.js",
    "cuthol": "node dist/cli.js",
    "test:fast": "node scripts/test.mjs --fast",
    "test:tiers": "node scripts/test-tiers.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "gsap": "3.14.2",
    "hyperframes": "0.9.15",
    "puppeteer-core": "25.14.0"
  }
}
